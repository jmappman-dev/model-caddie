# Copy to .env (never commit .env) or set these in your shell.
# The router never reads the VALUES; it only checks whether each one is set,
# to decide which lanes are available. Leave a line out to disable that lane.

# research lane (anthropic, openai, google profiles)
PERPLEXITY_API_KEY=

# large-context lane (anthropic, openai profiles)
GEMINI_API_KEY=

# reviewer lane (openai, google profiles)
ANTHROPIC_API_KEY=

# Optional: point at a config file instead of ./model-router.config.json
# MODEL_ROUTER_CONFIG=./my-router.json
